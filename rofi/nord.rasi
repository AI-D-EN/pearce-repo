configuration {
    font: "JetBrainsMono Nerd Font 12";
}

/* Nord color palette */
* {
    bg0: #2E3440;
    bg1: #3B4252;
    bg2: #5E81AC;
    bordercol: #81A1C1;
    fg0: #ECEFF4;
}

/* Window */
window {
    width: 400px;

    anchor: northeast;
    location: northeast;

    x-offset: -13px;
    y-offset: 13px;

    border: 2px;
    border-radius: 16px;
    border-color: @bordercol;

    background-color: @bg0;
}

/* Main container */
mainbox {
    padding: 12px;
    background-color: @bg0;
}

/* Search bar container */
inputbar {
    children: [ prompt, entry ];
    padding: 8px;
    border-radius: 10px;
    background-color: @bg1;
}

/* Prompt text ("Clip-Board") */
prompt {
    background-color: @bg1;
    text-color: @fg0;
}

/* Search text field */
entry {
    background-color: @bg1;
    text-color: @fg0;
}

/* Remove extra textbox artifacts */
textbox {
    background-color: @bg1;
    text-color: @fg0;
}

/* Clipboard list container */
listview {
    spacing: 8px;
    padding: 6px;
    background-color: @bg0;
}

/* Clipboard rows */
element {
    background-color: @bg1;
    border-radius: 10px;
    padding: 8px;
}

/* Row text */
element-text {
    background-color: transparent;
    text-color: @fg0;
}

/* Selected row */
element selected {
    background-color: @bg2;
}

/* Selected row text */
element-text selected {
    text-color: @fg0;
}
