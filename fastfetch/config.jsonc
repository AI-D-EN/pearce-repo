{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/mylogo.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0
    }
  },

  "display": {
    "key": {
      "width": 0
    },
    "separator": " "
  },

  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",

    {
      "type": "cpu",
      "showTemp": true
    },

    {
      "type": "gpu",
      "showTemp": true
    },

    "memory",

    {
      "type": "disk",
      "folders": [
        "/"
      ]
    },

    "localip",
    "break",
    "colors"
  ]
}
