{
  "workbench.colorTheme": "Default Dark Modern",
  "window.titleBarStyle": "custom",

  "workbench.colorCustomizations": {
    "editor.background": "{{colors.background.default.hex}}",
    "editor.foreground": "{{colors.on_background.default.hex}}",

    "sideBar.background": "{{colors.surface.default.hex}}",
    "sideBar.foreground": "{{colors.on_surface.default.hex}}",
    "sideBar.border": "{{colors.outline.default.hex}}",

    "sideBarSectionHeader.border": "{{colors.outline.default.hex}}",

    "activityBar.background": "{{colors.surface_container.default.hex}}",
    "activityBar.foreground": "{{colors.on_surface.default.hex}}",

    "titleBar.activeBackground": "{{colors.surface.default.hex}}",
    "titleBar.activeForeground": "{{colors.on_surface.default.hex}}",
    "titleBar.border": "{{colors.outline.default.hex}}",

    "statusBar.background": "{{colors.primary.default.hex}}",
    "statusBar.foreground": "{{colors.on_primary.default.hex}}",

    "button.background": "{{colors.primary.default.hex}}",
    "button.foreground": "{{colors.on_primary.default.hex}}",

    "input.background": "{{colors.surface_container.default.hex}}",
    "input.foreground": "{{colors.on_surface.default.hex}}",

    "editorCursor.foreground": "{{colors.primary.default.hex}}",
    "editor.selectionBackground": "{{colors.primary.default.hex}}55",

    "editorLineNumber.foreground": "{{colors.outline.default.hex}}",
    "editorLineNumber.activeForeground": "{{colors.primary.default.hex}}",

    "editorGutter.background": "{{colors.background.default.hex}}",

    "editorIndentGuide.background1": "{{colors.outline.default.hex}}33",
    "editorIndentGuide.activeBackground1": "{{colors.primary.default.hex}}55",

    "terminal.background": "{{colors.background.default.hex}}",

    "textLink.foreground": "{{colors.primary.default.hex}}",
    "textLink.activeForeground": "{{colors.primary.default.hex}}",

    "focusBorder": "{{colors.primary.default.hex}}",

    "tab.activeBackground": "{{colors.background.default.hex}}",
    "tab.activeForeground": "{{colors.on_background.default.hex}}",
    "tab.activeBorder": "{{colors.primary.default.hex}}",
    "tab.activeBorderTop": "{{colors.primary.default.hex}}",

    "tab.inactiveBackground": "{{colors.surface.default.hex}}",
    "tab.inactiveForeground": "{{colors.on_surface.default.hex}}",

    "editorGroupHeader.tabsBackground": "{{colors.surface.default.hex}}",
    "editorGroupHeader.tabsBorder": "{{colors.outline.default.hex}}",
    "editorGroupHeader.border": "{{colors.outline.default.hex}}",
    "editorGroupHeader.noTabsBackground": "{{colors.surface.default.hex}}",

    "editorGroup.border": "{{colors.outline.default.hex}}",

    "activityBarBadge.background": "{{colors.primary.default.hex}}",
    "activityBarBadge.foreground": "{{colors.on_primary.default.hex}}",

    "badge.background": "{{colors.primary.default.hex}}",
    "badge.foreground": "{{colors.on_primary.default.hex}}",

    "progressBar.background": "{{colors.primary.default.hex}}",

    "list.activeSelectionBackground": "{{colors.primary.default.hex}}",
    "list.activeSelectionForeground": "{{colors.on_primary.default.hex}}",

    "list.highlightForeground": "{{colors.primary.default.hex}}",

    "editorLink.activeForeground": "{{colors.primary.default.hex}}",

    "menu.background": "{{colors.surface.default.hex}}",
    "menu.foreground": "{{colors.on_surface.default.hex}}",

    "menubar.selectionBackground": "{{colors.primary.default.hex}}22",
    "menubar.selectionForeground": "{{colors.primary.default.hex}}",

    "dropdown.background": "{{colors.surface.default.hex}}",
    "dropdown.foreground": "{{colors.on_surface.default.hex}}",

    "panel.background": "{{colors.background.default.hex}}",
    "panel.border": "{{colors.outline.default.hex}}",

    "commandCenter.background": "{{colors.surface.default.hex}}",
    "commandCenter.foreground": "{{colors.on_surface.default.hex}}",
    "commandCenter.border": "{{colors.outline.default.hex}}",

    "breadcrumb.background": "{{colors.surface.default.hex}}",
    "breadcrumb.foreground": "{{colors.on_surface.default.hex}}",

    "chat.requestBorder": "{{colors.primary.default.hex}}",
    "chat.slashCommandForeground": "{{colors.primary.default.hex}}",

    "editorWidget.border": "{{colors.primary.default.hex}}",

    "peekView.border": "{{colors.primary.default.hex}}",

    "settings.modifiedItemIndicator": "{{colors.primary.default.hex}}",

    "window.activeBorder": "{{colors.outline.default.hex}}",
    "window.inactiveBorder": "{{colors.outline.default.hex}}"
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["keyword"],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}"
        }
      },
      {
        "scope": ["string"],
        "settings": {
          "foreground": "{{colors.secondary.default.hex}}"
        }
      },
      {
        "scope": ["comment"],
        "settings": {
          "foreground": "{{colors.outline.default.hex}}"
        }
      }
    ]
  },

  "security.workspace.trust.untrustedFiles": "open"
}